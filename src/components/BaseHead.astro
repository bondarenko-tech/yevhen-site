---
interface Props {
  title: string;
  description: string;
  currentUrl: string;
  canonical?: string;
  robots?: string;
  image?: string;
  isProduct?: boolean;
}

const {
  title,
  description,
  currentUrl,
  canonical,
  robots = "index, follow",
  image = "/og/site.webp",
  isProduct = false,
} = Astro.props as Props;

const site = "https://yevhenbondarenko.com";
const siteName = "Yevhen Bondarenko – Smarte Technik";

const path = Astro.url.pathname;
const searchParams = Astro.url.searchParams;

function ensureAbsoluteUrl(url: string) {
  return url.startsWith("http") ? url : new URL(url, site).toString();
}

function normalizeUrl(url: string) {
  const u = new URL(ensureAbsoluteUrl(url));
  u.search = "";
  u.hash = "";

  if (!u.pathname.endsWith("/")) {
    u.pathname = `${u.pathname}/`;
  }
  return u.toString();
}

function safeDescription(text?: string): string {
  const base =
    text?.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim() ||
    "Unabhängige Produktübersichten und verständliche Technik-Vergleiche für Smart Home, Sicherheit und Haushalt.";

  if (base.length <= 155) return base;
  const cut = base.slice(0, 156);
  return cut.slice(0, cut.lastIndexOf(" ")).trim() + "...";
}

function safeTitle(text?: string): string {
  const base = text?.replace(/\s+/g, " ").trim() || siteName;
  if (base.length <= 65) return base;
  const cut = base.slice(0, 66);
  return cut.slice(0, cut.lastIndexOf(" ")).trim() + "...";
}

const finalTitle = safeTitle(title);
const finalDescription = safeDescription(description);

const finalUrl = normalizeUrl(currentUrl);
// Если canonical передан вручную, делаем его абсолютным, если нет — берем нормализованный текущий
const canonicalUrl = canonical ? ensureAbsoluteUrl(canonical) : finalUrl; 
const ogImage = ensureAbsoluteUrl(image);

const isNoindex =
  path.startsWith("/admin/") ||
  searchParams.has("q");

const finalRobots = isNoindex ? "noindex, follow" : robots;
const ogType = "website";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<meta name="referrer" content="strict-origin-when-cross-origin" />

<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/webp" sizes="96x96" href="/favicon-96x96.webp" />
<link rel="apple-touch-icon" href="/apple-touch-icon.webp" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" hreflang="de" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

<title>{finalTitle}</title>
<link rel="canonical" href={canonicalUrl} />

<meta name="description" content={finalDescription} />
<meta name="robots" content={finalRobots} />
<meta name="author" content="Yevhen Bondarenko" />
<meta name="language" content="de" />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:url" content={finalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={finalTitle} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="de_DE" />
<meta property="og:locale:alternate" content="de_AT" />
<meta property="og:locale:alternate" content="de_CH" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={finalTitle} />
<meta name="twitter:description" content={finalDescription} />
<meta name="twitter:image" content={ogImage} />