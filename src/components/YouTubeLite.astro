---
interface Props {
  videoId: string;
  title: string;
}

const { videoId, title } = Astro.props;

const embedUrl =
  `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
---

<div class="group relative overflow-hidden rounded-2xl border border-neutral-200 bg-neutral-950">
  <button
    type="button"
    class="relative flex aspect-video w-full items-center justify-center bg-neutral-950 p-6 text-white"
    aria-label={`Video laden: ${title}`}
    onclick={`this.outerHTML = '<iframe class="aspect-video w-full" src="${embedUrl}" title="${title}" loading="eager" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>'`}
  >
    <span class="flex flex-col items-center gap-3 text-center">
      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white text-2xl text-neutral-950 shadow">
        ▶
      </span>

      <span class="text-base font-semibold">
        Video ansehen
      </span>

      <span class="max-w-md text-sm text-neutral-300">
        Mit dem Klick wird das YouTube-Video geladen.
      </span>
    </span>
  </button>
</div>