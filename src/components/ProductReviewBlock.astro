---
const { produkt } = Astro.props;
const n = produkt.data;

const title = n.title ?? "Dieses Produkt";
const category = n.kategorie ?? "Technik";
const type = n.typ ?? "Produkt";
const teaser = n.teaser ?? n.description ?? "";
const brand = typeof n.brand === "string" ? n.brand : "";
const specs = Array.isArray(n.specs) ? n.specs.slice(0, 4) : [];
---

<section class="mt-10 max-w-3xl">

  <h2 class="text-lg font-bold mb-4">Einordnung</h2>

  <p class="text-neutral-700 mb-4">
    {title} ist ein {type} aus dem Bereich {category}.
    {brand && <> Die Marke ist {brand}.</>}
  </p>

  {teaser && (
    <p class="text-neutral-700 mb-6">
      {teaser}
    </p>
  )}

  {specs.length > 0 && (
    <>
      <h3 class="font-semibold mt-6 mb-2">Wichtige Punkte</h3>
      <ul class="text-sm text-neutral-600 mb-6 space-y-1">
        {specs.map((item: string) => (
      <li>{item}</li>
    ))}
      </ul>
    </>
  )}

  <h3 class="font-semibold mt-6 mb-2">Wichtiger Hinweis</h3>
  <p class="text-sm text-neutral-600 mb-6">
    Vor dem Kauf sollten Preis, Verfügbarkeit, Kompatibilität und Einsatzbereich geprüft werden.
    Produktangaben können sich beim Anbieter ändern.
  </p>

  <h3 class="font-semibold mt-6 mb-2">Kurzfazit</h3>
  <p class="text-neutral-800 font-medium">
    Sinnvoll, wenn das Produkt zum eigenen Bedarf passt und die wichtigsten technischen Daten vor dem Kauf geprüft wurden.
  </p>

</section>