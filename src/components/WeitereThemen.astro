---
import { getCollection } from "astro:content";

const posts = await getCollection("verstehen");
const current = Astro.url.pathname;

const topicMap: Record<string, string[]> = {
  sicherheit: [
    "ueberwachungskamera-kaufen",
    "innenkamera-oder-aussenkamera",
    "video-tuerklingel-kaufen",
    "alarmanlage-kaufen",
    "smart-home-grundlagen",
  ],

  netzwerk: [
    "wlan-verbessern-zuhause",
    "wlan-langsam-was-tun",
    "wlan-probleme-loesen",
    "wlan-reichweite-erhoehen",
    "wlan-router-kaufberatung",
    "mesh-vs-repeater",
  ],

  klima: [
    "raum-kuehlen-im-sommer",
    "ventilator-kaufen",
    "mobile-klimaanlage-kaufen",
    "luftentfeuchter-kaufen",
  ],

  strom: [
    "stromverbrauch-messen",
    "smarte-steckdose",
    "steckdosenleiste",
  ],

  haushalt: [
    "wischsauger-kaufen",
    "akku-staubsauger-kaufen",
  ],

  smartHome: [
    "smart-home-grundlagen",
    "smarte-steckdose",
    "matter-erklaert",
  ],
};

function detectTopic(path: string) {
  if (
    path.includes("/sicherheit/") ||
    path.includes("kamera") ||
    path.includes("tuerklingel") ||
    path.includes("tuerschloss") ||
    path.includes("alarm")
  ) {
    return "sicherheit";
  }

  if (
    path.includes("/klima/") ||
    path.includes("klimaanlage") ||
    path.includes("ventilator") ||
    path.includes("luftentfeuchter") ||
    path.includes("luftreiniger") ||
    path.includes("heizung") ||
    path.includes("kuehlen")
  ) {
    return "klima";
  }

  if (
    path.includes("/netzwerk/") ||
    path.includes("wlan") ||
    path.includes("wifi") ||
    path.includes("repeater") ||
    path.includes("mesh") ||
    path.includes("powerline") ||
    path.includes("router")
  ) {
    return "netzwerk";
  }

  if (
    path.includes("/strom/") ||
    path.includes("steckdose") ||
    path.includes("steckdosenleiste") ||
    path.includes("powerbank") ||
    path.includes("strom") ||
    path.includes("energie")
  ) {
    return "strom";
  }

  if (
    path.includes("wischsauger") ||
    path.includes("staubsauger") ||
    path.includes("reiniger")
  ) {
    return "haushalt";
  }

  if (path.includes("/smart-home/") || path.includes("smart") || path.includes("matter")) {
    return "smartHome";
  }

  return "netzwerk";
}

const topic = detectTopic(current);
const preferredSlugs = topicMap[topic] ?? [];

type VerstehenPost = (typeof posts)[number];

function isVerstehenPost(post: VerstehenPost | undefined): post is VerstehenPost {
  return Boolean(post);
}

const preferred = preferredSlugs
  .map((slug) => posts.find((p) => p.slug === slug))
  .filter(isVerstehenPost)
  .filter((p) => !current.includes(p.slug));

const fallback = posts
  .filter((p) => !current.includes(p.slug))
  .filter((p) => !preferredSlugs.includes(p.slug))
  .slice(0, 6 - preferred.length);

const related = [...preferred, ...fallback].slice(0, 6);
---

{related.length > 0 && (
  <section class="mt-12 rounded-3xl border border-neutral-200 bg-white p-6">
    <h2 class="text-xl font-semibold mb-4">
      Weitere hilfreiche Themen
    </h2>

    <p class="text-sm text-neutral-600 mb-4 max-w-2xl">
      Diese Erklärseiten helfen dabei, Technik besser einzuordnen und die passende Lösung für den eigenen Alltag zu finden.
    </p>

    <ul class="space-y-2">
      {related.map((post) => (
        <li>
          <a
            href={`/verstehen/${post.slug}/`}
            class="text-blue-600 hover:underline"
          >
            {post.data.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}