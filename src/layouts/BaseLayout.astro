---
import "../styles/base.css";
import "../styles/global.css";
import "../styles/prose.css";
import "../styles/buttons.css";

import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { CollectionEntry } from "astro:content";

interface LayoutProps {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  ogImage?: string;
  breadcrumb?: { name: string; url: string }[];
  jsonLd?: Record<string, any>[];
  produkt?: CollectionEntry<"produkte">;
  updated?: string;
}

const BASE_URL = "https://yevhenbondarenko.com";

let {
  title,
  description,
  canonical,
  robots = "index, follow",
  ogImage,
  breadcrumb = [],
  jsonLd = [],
  produkt,
  updated,
} = Astro.props as LayoutProps;

const clean = (s: string) => s.trim().replace(/\s+/g, " ");

function normalizeUrl(url: string) {
  const u = new URL(url, BASE_URL);
  u.search = "";
  u.hash = "";

  if (!u.pathname.endsWith("/")) {
    u.pathname = `${u.pathname}/`;
  }

  return u.toString();
}

function safeMetaDescription(src?: string) {
  const base =
    src?.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim() ||
    "Unabhängige Produktübersichten, technische Einordnung und verständliche Vergleiche für Zuhause.";

  return base.length <= 155
    ? base
    : base.slice(0, 155).replace(/\s+\S*$/, "").trim();
}

const currentUrl = normalizeUrl(Astro.url.pathname);
const canonicalUrl = normalizeUrl(canonical ?? currentUrl);

if (produkt) {
  title = title ?? clean(produkt.data.title);

  description = safeMetaDescription(
    description ??
      produkt.data.description ??
      produkt.data.teaser ??
      produkt.data.title
  );

  if (!ogImage && typeof produkt.data.image === "string") {
    ogImage = new URL(produkt.data.image, BASE_URL).toString();
  }
}

const computedTitle =
  title ?? "Technik Übersichten, Vergleiche & Erklärungen | Yevhen Bondarenko";

const computedDescription = safeMetaDescription(description);

const computedImage = ogImage ?? `${BASE_URL}/og/site.webp`;

const dateModified =
  updated ??
  (produkt?.data as any)?.dateModified ??
  produkt?.data.datum ??
  (produkt?.data as any)?.datePublished ??
  undefined;

const graph: Record<string, any>[] = [
  {
    "@type": "Organization",
    "@id": `${BASE_URL}/#organization`,
    name: "Bondarenko Empfehlungen",
    url: `${BASE_URL}/`,
  },
  {
    "@type": "WebSite",
    "@id": `${BASE_URL}/#website`,
    url: `${BASE_URL}/`,
    name: "Bondarenko Empfehlungen",
    publisher: {
      "@id": `${BASE_URL}/#organization`,
    },
    inLanguage: "de-DE",
  },
  {
    "@type": "WebPage",
    "@id": `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: computedTitle,
    description: computedDescription,
    inLanguage: "de-DE",
    isPartOf: {
      "@id": `${BASE_URL}/#website`,
    },
    ...(dateModified ? { dateModified } : {}),
  },
];

if (breadcrumb.length) {
  graph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumb.map((b, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: b.name,
      item: normalizeUrl(b.url),
    })),
  });
}

const faq = (produkt?.data as any)?.faq;

if (Array.isArray(faq) && faq.length > 0) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${canonicalUrl}#faq`,
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  });
}

if (produkt) {
  const price =
    typeof produkt.data.preis === "number"
      ? produkt.data.preis.toFixed(2)
      : undefined;

  const currency =
    produkt.data.priceCurrency ?? "EUR";

  const availability =
    produkt.data.availability ?? "https://schema.org/InStock";

  const productImage =
    typeof produkt.data.image === "string"
      ? new URL(produkt.data.image, BASE_URL).toString()
      : computedImage;

  graph.push({
    "@type": "Product",
    "@id": `${canonicalUrl}#product`,
    name: produkt.data.title,
    description: computedDescription,
    image: productImage,
    brand:
      typeof produkt.data.brand === "string"
        ? {
            "@type": "Brand",
            name: produkt.data.brand,
          }
        : undefined,
    sku: (produkt.data as any).sku,
    mpn: (produkt.data as any).mpn,
    offers: price
  ? {
      "@type": "Offer",
      url: canonicalUrl,
      price,
      priceCurrency: currency,
      availability,
      itemCondition: "https://schema.org/NewCondition",

      seller: {
        "@type": "Organization",
        name: "Amazon"
      },

      priceValidUntil: "2027-12-31"
    }
  : undefined,
  });
}

for (const item of jsonLd) {
  graph.push(item);
}

const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<!doctype html>
<html lang="de">
  <head>
    <BaseHead
      title={computedTitle}
      description={computedDescription}
      currentUrl={currentUrl}
      canonical={canonicalUrl}
      robots={robots}
      image={computedImage}
      isProduct={!!produkt}
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLdGraph)}
    />
  </head>

  <body class="bg-neutral-50 font-sans antialiased text-gray-900">
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>