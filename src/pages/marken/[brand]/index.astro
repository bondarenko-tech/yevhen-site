---
export const prerender = true;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const produkte = await getCollection("produkte");

  const makeSlug = (value: string) => {
    return String(value)
      .toLowerCase()
      .trim()
      .replace(/&/g, "und")
      .replace(/\+/g, "plus")
      .replace(/ä/g, "ae")
      .replace(/ö/g, "oe")
      .replace(/ü/g, "ue")
      .replace(/ß/g, "ss")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  };

  const brandMap = new Map();

  for (const entry of produkte) {
    const brand = entry.data?.brand;

    if (!brand || typeof brand !== "string") continue;

    const brandName = brand.trim();
    const brandSlug = makeSlug(brandName);

    if (!brandSlug) continue;

    if (!brandMap.has(brandSlug)) {
      brandMap.set(brandSlug, brandName);
    }
  }

  return Array.from(brandMap.entries()).map(([brandSlug, brandName]) => ({
    params: {
      brand: brandSlug,
    },
    props: {
      brandName,
    },
  }));
}

const SITE =
  Astro.site?.toString().replace(/\/$/, "") ??
  "https://yevhenbondarenko.com";

const brandName = Astro.props.brandName;
const brandSlug = Astro.params.brand;

const canonical = `${SITE}/marken/${brandSlug}/`;

const title = `${brandName} Empfehlungen – Technik Produkte nach Hersteller`;
const description = `${brandName} Empfehlungen auf yevhenbondarenko.com. Finden Sie passende Technik-Produkte aus Smart Home, WLAN, Sicherheit, Klima, Stromversorgung und Haushalt.`;

const produkte = await getCollection("produkte");

const makeSlug = (value: string) => {
  return String(value)
    .toLowerCase()
    .trim()
    .replace(/&/g, "und")
    .replace(/\+/g, "plus")
    .replace(/ä/g, "ae")
    .replace(/ö/g, "oe")
    .replace(/ü/g, "ue")
    .replace(/ß/g, "ss")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
};

function getEntrySlug(entry: any) {
  return String(entry.id || "")
    .replace(/\.mdx?$/, "")
    .trim();
}

function getProductUrl(entry: any) {
  if (entry.data?.link && typeof entry.data.link === "string") {
    return entry.data.link;
  }

  if (!entry.data?.kategorie) {
    return "/empfehlungen/";
  }

  return `/empfehlungen/${entry.data.kategorie}/${getEntrySlug(entry)}/`;
}

const brandProducts = produkte
  .filter((entry) => {
    const brand = entry.data?.brand;

    if (!brand || typeof brand !== "string") return false;

    return makeSlug(brand) === brandSlug;
  })
  .sort((a, b) => {
    const dateA = new Date(a.data?.datum ?? 0).getTime();
    const dateB = new Date(b.data?.datum ?? 0).getTime();

    return dateB - dateA;
  });

const categories = Array.from(
  new Set(
    brandProducts
      .map((entry) => entry.data?.kategorie)
      .filter((category) => typeof category === "string" && category.length > 0)
  )
).sort((a, b) => String(a).localeCompare(String(b), "de"));

const breadcrumb = [
  { name: "Startseite", url: `${SITE}/` },
  { name: "Marken", url: `${SITE}/marken/` },
  { name: brandName, url: canonical },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  breadcrumb={breadcrumb}
>

<main class="mx-auto max-w-6xl px-4 py-12 md:py-20">

  <header class="max-w-3xl mb-16">
    <span class="inline-block px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-[10px] font-black uppercase tracking-[0.2em] mb-4">
      Herstellerübersicht
    </span>

    <h1 class="text-4xl md:text-6xl font-black text-neutral-900 leading-tight mb-6 text-balance">
      {brandName} <span class="text-blue-600 italic">Empfehlungen</span>
    </h1>

    <p class="text-lg md:text-xl text-neutral-600 leading-relaxed font-medium">
      Hier finden Sie Technik-Produkte von {brandName}, die auf yevhenbondarenko.com vorgestellt, eingeordnet oder empfohlen werden.
    </p>
  </header>

  <section class="mb-16 grid gap-6 md:grid-cols-3">
    <article class="rounded-[28px] border border-neutral-100 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-black text-neutral-900 mb-3">
        Produkte nach Marke
      </h2>
      <p class="text-sm leading-relaxed text-neutral-600 font-medium">
        Diese Markenseite bündelt alle vorhandenen Empfehlungen von {brandName}.
        So lassen sich Produkte eines Herstellers schneller finden und besser einordnen.
      </p>
    </article>

    <article class="rounded-[28px] border border-neutral-100 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-black text-neutral-900 mb-3">
        Kategorien schneller erkennen
      </h2>
      <p class="text-sm leading-relaxed text-neutral-600 font-medium">
        Die Produkte werden nach Bereichen wie Smart Home, WLAN, Sicherheit, Strom,
        Klima oder Haushalt eingeordnet. Das hilft bei der Auswahl passender Geräte.
      </p>
    </article>

    <article class="rounded-[28px] border border-neutral-100 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-black text-neutral-900 mb-3">
        Empfehlungen vergleichen
      </h2>
      <p class="text-sm leading-relaxed text-neutral-600 font-medium">
        Wenn mehrere Produkte von {brandName} vorhanden sind, können Nutzer die
        Einsatzbereiche, Funktionen und Alternativen schneller vergleichen.
      </p>
    </article>
  </section>

  <section class="mb-20">
    <h2 class="text-xs font-black uppercase tracking-[0.2em] text-neutral-400 mb-8">
      Produkte von {brandName}
    </h2>

    {brandProducts.length === 0 ? (
      <p class="text-neutral-500">
        Für diese Marke wurden noch keine passenden Empfehlungen gefunden.
      </p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {brandProducts.map((entry) => (
          <a
            href={getProductUrl(entry)}
            class="group relative rounded-[32px] border border-neutral-100 bg-neutral-50/50 p-8 hover:bg-white hover:shadow-2xl hover:shadow-blue-500/5 transition-all duration-500"
          >
            {entry.data?.image && typeof entry.data.image === "string" && (
              <img
                src={entry.data.image}
                alt={entry.data.title}
                class="mb-5 aspect-video w-full rounded-2xl object-cover"
                loading="lazy"
              />
            )}

            {entry.data?.kategorie && (
              <span class="text-[10px] font-black uppercase tracking-widest text-blue-600 mb-2 block">
                {entry.data.kategorie}
              </span>
            )}

            <h2 class="text-xl font-bold mb-3 text-neutral-900 group-hover:text-blue-600 transition-colors">
              {entry.data.title}
            </h2>

            {entry.data?.description && (
              <p class="text-sm text-neutral-500 leading-relaxed font-medium line-clamp-3">
                {entry.data.description}
              </p>
            )}
          </a>
        ))}
      </div>
    )}
  </section>

  {categories.length > 0 && (
    <section class="py-12 border-t border-neutral-100">
      <h2 class="text-xs font-black uppercase tracking-[0.2em] text-neutral-400 mb-8">
        Kategorien
      </h2>

      <div class="flex flex-wrap gap-3">
        {categories.map((category) => (
          <span class="rounded-full bg-neutral-100 px-4 py-2 text-sm font-bold text-neutral-700">
            {category}
          </span>
        ))}
      </div>
    </section>
  )}

    <section class="py-12 border-t border-neutral-100">
    <h2 class="text-xs font-black uppercase tracking-[0.2em] text-neutral-400 mb-8">
      Warum diese Markenseite hilfreich ist
    </h2>

    <div class="prose prose-neutral max-w-none">
      <p>
        Viele Nutzer suchen Technik-Produkte nicht nur nach Kategorie, sondern gezielt nach einem Hersteller.
        Diese Seite sammelt deshalb alle vorhandenen Empfehlungen von {brandName} an einem Ort.
      </p>

      <p>
        Besonders hilfreich ist das, wenn bereits Vertrauen in eine Marke besteht, aber noch unklar ist,
        welches Produkt zur eigenen Situation passt.
      </p>

      <p>
        Die Übersicht kann bei der Auswahl helfen, ersetzt aber keinen Labortest und keine individuelle Beratung.
        Entscheidend bleiben Einsatzbereich, Ausstattung, Preis-Leistungs-Verhältnis und persönliche Anforderungen.
      </p>
    </div>
  </section>

  <section class="mt-24 p-8 md:p-16 rounded-[40px] bg-neutral-900 text-center relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-full bg-blue-600/10 pointer-events-none"></div>

    <div class="relative z-10">
      <h2 class="text-2xl md:text-3xl font-black text-white mb-4">
        Weitere Technik-Empfehlungen?
      </h2>

      <p class="text-neutral-400 mb-10 max-w-xl mx-auto font-medium">
        Wenn Sie nicht nach Marke suchen möchten, finden Sie hier alle Empfehlungen und Vergleiche.
      </p>

      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a
          href="/empfehlungen/"
          class="bg-white text-neutral-900 px-8 py-4 rounded-xl font-bold hover:bg-blue-600 hover:text-white transition-all"
        >
          Alle Empfehlungen
        </a>

        <a
          href="/vergleiche/"
          class="bg-neutral-800 text-white px-8 py-4 rounded-xl font-bold hover:bg-neutral-700 transition-all border border-neutral-700"
        >
          Vergleiche ansehen
        </a>
      </div>
    </div>
  </section>

</main>
</BaseLayout>
