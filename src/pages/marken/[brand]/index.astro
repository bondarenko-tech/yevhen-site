---
export const prerender = true;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const produkte = await getCollection("produkte");

  const makeSlug = (value: string) => {
    return String(value)
      .toLowerCase()
      .trim()
      .replace(/&/g, "und")
      .replace(/\+/g, "plus")
      .replace(/ä/g, "ae")
      .replace(/ö/g, "oe")
      .replace(/ü/g, "ue")
      .replace(/ß/g, "ss")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  };

  const brandMap = new Map<string, string>();

  for (const entry of produkte) {
    const brand = entry.data?.brand;

    if (!brand || typeof brand !== "string") continue;

    const brandName = brand.trim();
    const brandSlug = makeSlug(brandName);

    if (!brandSlug) continue;

    if (!brandMap.has(brandSlug)) {
      brandMap.set(brandSlug, brandName);
    }
  }

  return Array.from(brandMap.entries()).map(([brandSlug, brandName]) => ({
    params: {
      brand: brandSlug,
    },
    props: {
      brandName,
    },
  }));
}

const SITE =
  Astro.site?.toString().replace(/\/$/, "") ??
  "https://yevhenbondarenko.com";

const makeSlug = (value: string) => {
  return String(value)
    .toLowerCase()
    .trim()
    .replace(/&/g, "und")
    .replace(/\+/g, "plus")
    .replace(/ä/g, "ae")
    .replace(/ö/g, "oe")
    .replace(/ü/g, "ue")
    .replace(/ß/g, "ss")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
};

const brandName = String(Astro.props.brandName ?? "").trim();
const brandSlug = String(Astro.params.brand ?? "").trim();

const canonical = `${SITE}/marken/${brandSlug}/`;

const produkte = await getCollection("produkte");

function getEntrySlug(entry: any) {
  return (
    String(entry.id || "")
      .replace(/\.mdx?$/, "")
      .split("/")
      .pop()
      ?.trim() ?? ""
  );
}

function getProductUrl(entry: any) {
  if (entry.data?.link && typeof entry.data.link === "string") {
    const link = entry.data.link.trim();

    if (link.startsWith("/")) {
      return link;
    }

    if (link.startsWith(SITE)) {
      return link;
    }
  }

  const category = String(entry.data?.kategorie ?? "").trim();
  const slug = getEntrySlug(entry);

  if (!category || !slug) {
    return "/empfehlungen/";
  }

  return `/empfehlungen/${category}/${slug}/`;
}

function getTimestamp(value: unknown) {
  if (!value) return 0;

  const date = new Date(value as string | number | Date);
  const timestamp = date.getTime();

  return Number.isNaN(timestamp) ? 0 : timestamp;
}

const brandProducts = produkte
  .filter((entry) => {
    const brand = entry.data?.brand;

    if (!brand || typeof brand !== "string") return false;

    return makeSlug(brand) === brandSlug;
  })
  .sort((a, b) => {
    const dateA = getTimestamp(a.data?.datum);
    const dateB = getTimestamp(b.data?.datum);

    return dateB - dateA;
  });

const productCount = brandProducts.length;

const categories = Array.from(
  new Set(
    brandProducts
      .map((entry) => entry.data?.kategorie)
      .filter(
        (category): category is string =>
          typeof category === "string" && category.trim().length > 0
      )
      .map((category) => category.trim())
  )
).sort((a, b) => a.localeCompare(b, "de"));

const title =
  productCount === 1
    ? `${brandName}: Technik-Empfehlung und Produktübersicht`
    : `${brandName}: ${productCount} Technik-Empfehlungen im Überblick`;

const description =
  productCount === 1
    ? `Alle vorhandenen Empfehlungen zu ${brandName} auf Bondarenko Empfehlungen. Produkt ansehen und passende Technik schneller finden.`
    : `${productCount} Technik-Produkte von ${brandName} auf Bondarenko Empfehlungen. Empfehlungen nach Kategorie ansehen und passende Geräte schneller finden.`;

const breadcrumb = [
  { name: "Startseite", url: `${SITE}/` },
  { name: "Marken", url: `${SITE}/marken/` },
  { name: brandName, url: canonical },
];

const itemListSchema =
  productCount > 0
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: `${brandName} Empfehlungen`,
        url: canonical,
        numberOfItems: productCount,
        itemListElement: brandProducts.map((entry, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: entry.data?.title ?? `${brandName} Produkt`,
          url: new URL(getProductUrl(entry), SITE).toString(),
        })),
      }
    : null;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  breadcrumb={breadcrumb}
>
  {itemListSchema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(itemListSchema)}
    />
  )}

  <main class="mx-auto max-w-6xl px-4 py-12 md:py-20">
    <header class="max-w-4xl mb-12 md:mb-16">
      <span
        class="inline-block px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-[10px] font-black uppercase tracking-[0.2em] mb-4"
      >
        Herstellerübersicht
      </span>

      <h1
        class="text-4xl md:text-6xl font-black text-neutral-900 leading-tight mb-6 text-balance"
      >
        {brandName} <span class="text-blue-600 italic">Empfehlungen</span>
      </h1>

      <p class="text-lg md:text-xl text-neutral-600 leading-relaxed font-medium">
        {productCount === 1
          ? `Hier finden Sie die aktuell auf Bondarenko Empfehlungen veröffentlichte Produktempfehlung von ${brandName}.`
          : `Hier finden Sie ${productCount} aktuell auf Bondarenko Empfehlungen veröffentlichte Technik-Produkte von ${brandName}.`}
      </p>

      {categories.length > 0 && (
        <p class="mt-4 text-sm text-neutral-500 leading-relaxed">
          Vertretene Bereiche: {categories.join(", ")}.
        </p>
      )}
    </header>

    {brandProducts.length === 0 ? (
      <section
        class="rounded-[28px] border border-neutral-100 bg-neutral-50 p-8 md:p-10"
      >
        <h2 class="text-2xl font-black text-neutral-900 mb-3">
          Noch keine Produkte verfügbar
        </h2>

        <p class="text-neutral-600 leading-relaxed">
          Für {brandName} sind derzeit keine veröffentlichten
          Produktempfehlungen vorhanden.
        </p>

        <a
          href="/empfehlungen/"
          class="inline-flex mt-6 bg-neutral-900 text-white px-6 py-3 rounded-xl font-bold hover:bg-blue-600 transition-colors"
        >
          Alle Empfehlungen ansehen
        </a>
      </section>
    ) : (
      <>
        <section class="mb-16 md:mb-20">
          <div
            class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between mb-8"
          >
            <div>
              <p
                class="text-xs font-black uppercase tracking-[0.2em] text-neutral-400 mb-2"
              >
                Produktübersicht
              </p>

              <h2 class="text-2xl md:text-3xl font-black text-neutral-900">
                Produkte von {brandName}
              </h2>
            </div>

            <p class="text-sm font-bold text-neutral-500">
              {productCount} {productCount === 1 ? "Produkt" : "Produkte"}
            </p>
          </div>

          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {brandProducts.map((entry) => {
              const productUrl = getProductUrl(entry);

              const category =
                typeof entry.data?.kategorie === "string"
                  ? entry.data.kategorie.trim()
                  : "";

              const productDescription =
                typeof entry.data?.teaser === "string" &&
                entry.data.teaser.trim()
                  ? entry.data.teaser.trim()
                  : typeof entry.data?.description === "string"
                    ? entry.data.description.trim()
                    : "";

              return (
                <article
                  class="group rounded-[32px] border border-neutral-100 bg-neutral-50/50 overflow-hidden hover:bg-white hover:shadow-2xl hover:shadow-blue-500/5 transition-all duration-500"
                >
                  <a
                    href={productUrl}
                    class="block h-full"
                    aria-label={`${entry.data.title} ansehen`}
                  >
                    {entry.data?.image &&
                      typeof entry.data.image === "string" && (
                        <div class="aspect-video overflow-hidden bg-white">
                          <img
                            src={entry.data.image}
                            alt={String(entry.data.title ?? brandName)}
                            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                            loading="lazy"
                            decoding="async"
                            width="640"
                            height="360"
                          />
                        </div>
                      )}

                    <div class="p-7 md:p-8">
                      {category && (
                        <span
                          class="text-[10px] font-black uppercase tracking-widest text-blue-600 mb-3 block"
                        >
                          {category}
                        </span>
                      )}

                      <h3
                        class="text-xl font-bold mb-3 text-neutral-900 group-hover:text-blue-600 transition-colors"
                      >
                        {entry.data.title}
                      </h3>

                      {productDescription && (
                        <p
                          class="text-sm text-neutral-500 leading-relaxed font-medium line-clamp-3"
                        >
                          {productDescription}
                        </p>
                      )}

                      <span
                        class="inline-flex items-center mt-5 text-sm font-black text-neutral-900 group-hover:text-blue-600 transition-colors"
                        aria-hidden="true"
                      >
                        Empfehlung ansehen
                        <span class="ml-2">→</span>
                      </span>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        </section>

        {categories.length > 0 && (
          <section class="py-10 md:py-12 border-t border-neutral-100">
            <h2 class="text-xl md:text-2xl font-black text-neutral-900 mb-5">
              {brandName} nach Kategorie
            </h2>

            <p class="max-w-3xl text-neutral-600 leading-relaxed mb-6">
              Die vorhandenen Produkte von {brandName} sind auf dieser Seite
              folgenden Themenbereichen zugeordnet:
            </p>

            <div class="flex flex-wrap gap-3">
              {categories.map((category) => (
                <span
                  class="rounded-full bg-neutral-100 px-4 py-2 text-sm font-bold text-neutral-700"
                >
                  {category}
                </span>
              ))}
            </div>
          </section>
        )}

        <section class="py-10 md:py-12 border-t border-neutral-100">
          <h2 class="text-xl md:text-2xl font-black text-neutral-900 mb-5">
            Über diese {brandName}-Übersicht
          </h2>

          <div class="max-w-3xl text-neutral-600 leading-relaxed space-y-4">
            <p>
              Diese Seite sammelt die auf Bondarenko Empfehlungen vorhandenen
              Inhalte zu {brandName}. Sie dient vor allem dazu, veröffentlichte
              Produkte dieser Marke an einem Ort zu finden.
            </p>

            <p>
              Die einzelnen Produktseiten enthalten die jeweils verfügbaren
              Informationen zu Ausstattung, Einsatzbereich und wichtigen
              Hinweisen. Welche Lösung passt, hängt vom vorgesehenen
              Einsatzbereich und den persönlichen Anforderungen ab.
            </p>
          </div>
        </section>
      </>
    )}

    <section
      class="mt-16 md:mt-24 p-8 md:p-14 rounded-[40px] bg-neutral-900 text-center relative overflow-hidden"
    >
      <div
        class="absolute inset-0 bg-blue-600/10 pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="relative z-10">
        <h2 class="text-2xl md:text-3xl font-black text-white mb-4">
          Weitere Technik finden
        </h2>

        <p
          class="text-neutral-400 mb-8 max-w-xl mx-auto font-medium leading-relaxed"
        >
          Entdecken Sie weitere Produktempfehlungen oder vergleichen Sie
          passende Geräte miteinander.
        </p>

        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a
            href="/empfehlungen/"
            class="bg-white text-neutral-900 px-8 py-4 rounded-xl font-bold hover:bg-blue-600 hover:text-white transition-all"
          >
            Alle Empfehlungen
          </a>

          <a
            href="/vergleiche/"
            class="bg-neutral-800 text-white px-8 py-4 rounded-xl font-bold hover:bg-neutral-700 transition-all border border-neutral-700"
          >
            Vergleiche ansehen
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>