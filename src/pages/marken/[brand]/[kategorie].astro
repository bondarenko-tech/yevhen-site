---
export const prerender = true;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const makeSlug = (value: string) =>
  String(value)
    .toLowerCase()
    .trim()
    .replace(/&/g, "und")
    .replace(/\+/g, "plus")
    .replace(/ä/g, "ae")
    .replace(/ö/g, "oe")
    .replace(/ü/g, "ue")
    .replace(/ß/g, "ss")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

export async function getStaticPaths() {
  const { slugify } = await import("../../../lib/slugify");

  const makeSlug = (value: string) => slugify(value);

  const produkte = await getCollection("produkte");
  const paths = [];
  const seen = new Set<string>();

  for (const entry of produkte) {
    const brand = entry.data?.brand;
    const category = entry.data?.kategorie;

    if (typeof brand !== "string" || !brand.trim()) continue;
    if (typeof category !== "string" || !category.trim()) continue;

    const brandName = brand.trim();
    const categoryName = category.trim();
    const brandSlug = makeSlug(brandName);
    const categorySlug = makeSlug(categoryName);

    if (!brandSlug || !categorySlug) continue;

    const key = `${brandSlug}|${categorySlug}`;
    if (seen.has(key)) continue;
    seen.add(key);

    paths.push({
      params: {
        brand: brandSlug,
        kategorie: categorySlug,
      },
      props: {
        brandName,
        categoryName,
      },
    });
  }

  return paths;
}

const SITE =
  Astro.site?.toString().replace(/\/$/, "") ??
  "https://yevhenbondarenko.com";

const brandName = String(Astro.props.brandName ?? "").trim();
const categoryName = String(Astro.props.categoryName ?? "").trim();

const brandSlug = String(Astro.params.brand ?? "").trim();
const categorySlug = String(Astro.params.kategorie ?? "").trim();

const canonical = `${SITE}/marken/${brandSlug}/${categorySlug}/`;
const brandUrl = `/marken/${brandSlug}/`;

const produkte = await getCollection("produkte");

function getEntrySlug(entry: any) {
  return (
    String(entry.id || "")
      .replace(/\.mdx?$/, "")
      .split("/")
      .pop()
      ?.trim() ?? ""
  );
}

function getProductUrl(entry: any) {
  if (typeof entry.data?.link === "string") {
    const link = entry.data.link.trim();

    if (link.startsWith("/")) return link;
    if (link.startsWith(SITE)) return link;
  }

  const category = String(entry.data?.kategorie ?? "").trim();
  const slug = getEntrySlug(entry);

  if (!category || !slug) return "/empfehlungen/";

  return `/empfehlungen/${category}/${slug}/`;
}

function getTimestamp(value: unknown) {
  if (!value) return 0;

  const timestamp = new Date(value as string | number | Date).getTime();
  return Number.isNaN(timestamp) ? 0 : timestamp;
}

const products = produkte
  .filter((entry) => {
    const brand = entry.data?.brand;
    const category = entry.data?.kategorie;

    return (
      typeof brand === "string" &&
      typeof category === "string" &&
      makeSlug(brand) === brandSlug &&
      makeSlug(category) === categorySlug
    );
  })
  .sort(
    (a, b) =>
      getTimestamp(b.data?.datum) - getTimestamp(a.data?.datum)
  );

const productCount = products.length;
const shouldIndex = productCount >= 1;

const title =
  productCount === 1
    ? `${brandName} ${categoryName}: Produkt & Kaufhinweise`
    : `${brandName} ${categoryName}: ${productCount} Produkte & Kaufhinweise`;

const description =
  productCount === 1
    ? `Entdecken Sie das vorgestellte ${brandName}-Produkt aus dem Bereich ${categoryName}. Mit praktischen Kaufhinweisen und passenden Alternativen.`
    : `${productCount} Produkte von ${brandName} im Bereich ${categoryName}: Informationen, Kaufhinweise und weitere passende Technik.`;

const breadcrumb = [
  { name: "Startseite", url: `${SITE}/` },
  { name: "Marken", url: `${SITE}/marken/` },
  { name: brandName, url: `${SITE}${brandUrl}` },
  { name: categoryName, url: canonical },
];

const categoryAdvice: Record<string, string[]> = {
  "netzwerk": [
    "Prüfen Sie die unterstützten WLAN-Standards, Frequenzen und Anschlüsse.",
    "Berücksichtigen Sie die Entfernung zum Router und mögliche Hindernisse.",
    "Achten Sie auf die Kompatibilität mit vorhandenen Geräten."
  ],
  "smart-home": [
    "Prüfen Sie, ob ein zusätzlicher Hub oder eine Bridge benötigt wird.",
    "Vergleichen Sie die unterstützten Apps und Funkstandards.",
    "Achten Sie auf Stromversorgung und Einbauvoraussetzungen."
  ],
  "sicherheit": [
    "Klären Sie, ob das Gerät für Innenräume oder Außenbereiche geeignet ist.",
    "Vergleichen Sie Speicheroptionen und mögliche laufende Kosten.",
    "Beachten Sie Datenschutz und Montagevoraussetzungen."
  ],
  "strom": [
    "Vergleichen Sie Leistung, Kapazität und Anschlüsse.",
    "Prüfen Sie die Kompatibilität mit vorhandenen Geräten.",
    "Beachten Sie Sicherheitsanforderungen und den Lieferumfang."
  ],
  "klima": [
    "Prüfen Sie Messbereich, Genauigkeit und Aufstellort.",
    "Achten Sie auf Stromversorgung und Bedienbarkeit.",
    "Vergleichen Sie Warnfunktionen und mögliche Zusatzgeräte."
  ],
  "haushalt": [
    "Vergleichen Sie Abmessungen und Platzbedarf.",
    "Berücksichtigen Sie Reinigung und Wartung.",
    "Prüfen Sie, welche Funktionen Sie tatsächlich benötigen."
  ],
};

const buyingAdvice =
  categoryAdvice[categorySlug] ?? [
    "Prüfen Sie den vorgesehenen Einsatzbereich.",
    "Vergleichen Sie die technischen Daten und den Lieferumfang.",
    "Achten Sie auf mögliche Einschränkungen vor dem Kauf.",
  ];


const productFamilies: { id: string; label: string; pattern: RegExp; checks: string[] }[] = [
  { id: "solarpanel", label: "Solarmodule", pattern: /solarpanel|solarmodul|solartasche|faltpanel|faltbares solarpanel/i, checks: ["Anschluss und elektrische Werte mit dem vorhandenen Gerät abgleichen.", "Maße, Gewicht und Einsatzort prüfen.", "Bei mobilen Modulen auf Aufstellung und Transport achten."] },
  { id: "powerstation", label: "Powerstations", pattern: /powerstation|power station|solargenerator/i, checks: ["Kapazität in Wh und Ausgangsleistung in W getrennt betrachten.", "Prüfen, ob die benötigten Anschlüsse vorhanden sind.", "Ladeoptionen, Gewicht und Einsatzbereich vergleichen."] },
  { id: "solarspeicher", label: "Balkonkraftwerk-Speicher", pattern: /solarbank|balkonkraftwerk.?speicher|solarspeicher|solarstromspeicher/i, checks: ["Kompatibilität mit Wechselrichter und Solarmodulen prüfen.", "Speicherkapazität und Erweiterbarkeit vergleichen.", "Installations- und Sicherheitsvorgaben beachten."] },
  { id: "powerbank", label: "Powerbanks", pattern: /powerbank/i, checks: ["Kapazität und Ladeleistung unterscheiden.", "USB-Anschlüsse und Ladeprotokolle des eigenen Geräts prüfen.", "Gewicht und Transportbedarf berücksichtigen."] },
  { id: "smart-meter", label: "Strommessung", pattern: /smart.?meter|stromzähler|energiemessgerät|powertracker|stromverbrauch messen/i, checks: ["Vor dem Kauf die Kompatibilität zum eigenen Stromzähler prüfen.", "Benötigte Stromversorgung und Verbindung beachten.", "Prüfen, welche Messwerte tatsächlich unterstützt werden."] },
  { id: "wlan-router", label: "WLAN-Router", pattern: /router|fritz!box/i, checks: ["Internetanschluss und Router-Kompatibilität prüfen.", "WLAN-Standard, Anschlüsse und Abdeckung vergleichen.", "Auf die Anforderungen vorhandener Geräte achten."] },
  { id: "wlan-repeater", label: "WLAN-Repeater", pattern: /repeater|wlan-verstärker/i, checks: ["Passenden Aufstellort zwischen Router und Funkloch wählen.", "WLAN-Standard und Mesh-Kompatibilität prüfen.", "Bei Bedarf LAN-Anschluss berücksichtigen."] },
  { id: "wlan-adapter", label: "WLAN-Adapter", pattern: /wlan-adapter|wifi-adapter|wlan usb adapter/i, checks: ["Betriebssystem und Treiberunterstützung prüfen.", "USB-Anschluss und unterstützte Frequenzbänder beachten.", "Antennenform und verfügbaren Platz berücksichtigen."] },
  { id: "kamera", label: "Überwachungskameras", pattern: /überwachungskamera|security camera|innenkamera|außenkamera|indoor.?cam|outdoor.?cam/i, checks: ["Innen- oder Außeneinsatz sowie Stromversorgung klären.", "Speicherung und mögliche Folgekosten prüfen.", "Bei Aufnahmen Datenschutz und Nachbargrundstücke beachten."] },
  { id: "thermostat", label: "Heizkörperthermostate", pattern: /heizkörperthermostat|thermostat/i, checks: ["Ventilanschluss und nötige Adapter prüfen.", "App, Funkstandard und eventuelle Bridge beachten.", "Bei Mietwohnungen vor Änderungen die Voraussetzungen klären."] },
  { id: "steckdose", label: "Smarte Steckdosen", pattern: /smart plug|smart.?steckdose|funksteckdose/i, checks: ["Zulässige Leistung der Steckdose beachten.", "WLAN, Funkstandard und Hub-Bedarf prüfen.", "Nur für geeignete angeschlossene Geräte einsetzen."] },
  { id: "hygrometer", label: "Hygrometer", pattern: /hygrometer|luftfeuchtigkeitsmesser|schimmelalarm/i, checks: ["Messfunktionen und Alarmgrenzen vergleichen.", "Geeigneten Aufstellort und Ablesbarkeit beachten.", "Stromversorgung und Bedienung prüfen."] },
  { id: "netzwerk-kabel", label: "Netzwerkkabel", pattern: /glasfaserkabel|lan.?kabel|ethernet.?kabel|patchkabel/i, checks: ["Steckertyp und Anschluss auf beiden Seiten prüfen.", "Kabellänge und Verlegeort berücksichtigen.", "Bei Glasfaser die genaue Steckervariante vergleichen."] },
  { id: "ladegeraet", label: "Ladegeräte", pattern: /ladegerät|usb.?c.?charger|ladestation/i, checks: ["Ladeleistung und Anschlüsse vergleichen.", "Kompatibilität mit den zu ladenden Geräten prüfen.", "Bei mehreren Anschlüssen die Leistungsaufteilung beachten."] },
  { id: "beleuchtung", label: "Beleuchtung", pattern: /led.?lampe|leuchtmittel|lichtschalter|dimmer/i, checks: ["Fassung, Spannung und Dimmbarkeit prüfen.", "Bei smarten Geräten Funkstandard und Hub-Bedarf klären.", "Arbeiten an der Elektroinstallation Fachkräften überlassen."] },
];

const getProductType = (entry: any): string | null => {
  const title = String(entry.data?.title ?? "");
  return productFamilies.find((family) => family.pattern.test(title))?.id ?? null;
};

const currentProductTypes = new Set(
  products.map(getProductType).filter((type): type is string => type !== null)
);

const familyAdvice = productFamilies.filter((family) => currentProductTypes.has(family.id));

// Only compare products in the same category and recognizable device family.
const alternatives = produkte
  .filter((entry) => {
    const brand = entry.data?.brand;
    const category = entry.data?.kategorie;
    const type = getProductType(entry);
    return typeof brand === "string" && typeof category === "string" &&
      makeSlug(brand) !== brandSlug && makeSlug(category) === categorySlug &&
      type !== null && currentProductTypes.has(type);
  })
  .sort((a, b) => getTimestamp(b.data?.datum) - getTimestamp(a.data?.datum));

const alternativesByFamily = familyAdvice
  .map((family) => ({
    label: family.label,
    products: alternatives.filter((entry) => getProductType(entry) === family.id),
  }))
  .filter((group) => group.products.length > 0);

const categoryLabels: Record<string, string> = {
  "strom": "Stromversorgung und Energie",
  "netzwerk": "Netzwerk und WLAN",
  "smart-home": "Smart Home",
  "sicherheit": "Sicherheit",
  "klima": "Raumklima",
  "haushalt": "Haushalt",
  "sonstiges": "Weitere Technik",
};
const categoryLabel = categoryLabels[categorySlug] ?? categoryName;

const itemListSchema = shouldIndex
  ? {
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: `${brandName} ${categoryName} Produkte`,
      url: canonical,
      numberOfItems: productCount,
      itemListElement: products.map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: entry.data?.title ?? `${brandName} ${categoryName}`,
        url: new URL(getProductUrl(entry), SITE).toString(),
      })),
    }
  : null;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  robots={shouldIndex ? "index, follow" : "noindex, follow"}
  breadcrumb={breadcrumb}
>
  {itemListSchema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(itemListSchema)}
    />
  )}

  <main class="mx-auto max-w-6xl px-4 py-12 md:py-20">

    <header class="max-w-4xl mb-12 md:mb-16">
      <a
        href={brandUrl}
        class="inline-flex items-center text-sm font-bold text-blue-600 hover:text-blue-700 mb-6"
      >
        ← Alle {brandName} Produkte
      </a>

      <span
        class="block text-xs font-black uppercase tracking-widest text-blue-600 mb-4"
      >
        Hersteller · Kategorie
      </span>

      <h1
        class="text-4xl md:text-6xl font-black text-neutral-900 leading-tight mb-6"
      >
        {brandName}
        <span class="text-blue-600 italic"> {categoryName}</span>
      </h1>

      <p class="text-lg md:text-xl text-neutral-600 leading-relaxed">
        {productCount === 1
          ? `Entdecken Sie das auf Bondarenko Empfehlungen vorgestellte Produkt von ${brandName} im Bereich ${categoryName}. Erfahren Sie, welche Punkte vor dem Kauf wichtig sind und wo Sie weitere passende Technik finden.`
          : `Hier finden Sie ${productCount} veröffentlichte Produkte von ${brandName} aus dem Bereich ${categoryName} sowie praktische Hinweise zur Auswahl.`}
      </p>
    </header>

    {products.length > 0 ? (
      <section class="mb-16">
        <div class="flex items-end justify-between gap-4 mb-8">
          <h2 class="text-2xl md:text-3xl font-black text-neutral-900">
            {brandName} Produkte aus {categoryName}
          </h2>

          <span class="text-sm font-bold text-neutral-500">
            {productCount} {productCount === 1 ? "Produkt" : "Produkte"}
          </span>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((entry) => {
            const productDescription =
              typeof entry.data?.teaser === "string" &&
              entry.data.teaser.trim()
                ? entry.data.teaser.trim()
                : typeof entry.data?.description === "string"
                  ? entry.data.description.trim()
                  : "";

            return (
              <article
                class="group rounded-[32px] border border-neutral-100 bg-neutral-50/50 overflow-hidden hover:bg-white hover:shadow-xl transition-all duration-300"
              >
                <a
                  href={getProductUrl(entry)}
                  class="block h-full"
                  aria-label={`${entry.data.title} ansehen`}
                >
                  {typeof entry.data?.image === "string" &&
                    entry.data.image && (
                      <div class="aspect-video overflow-hidden bg-white">
                        <img
                          src={entry.data.image}
                          alt={String(entry.data.title ?? brandName)}
                          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                          loading="lazy"
                          decoding="async"
                          width="640"
                          height="360"
                        />
                      </div>
                    )}

                  <div class="p-7 md:p-8">
                    <span
                      class="text-[10px] font-black uppercase tracking-widest text-blue-600 mb-3 block"
                    >
                      {categoryName}
                    </span>

                    <h3
                      class="text-xl font-bold mb-3 text-neutral-900 group-hover:text-blue-600"
                    >
                      {entry.data.title}
                    </h3>

                    {productDescription && (
                      <p class="text-sm text-neutral-500 leading-relaxed line-clamp-3">
                        {productDescription}
                      </p>
                    )}

                    <span class="inline-flex items-center mt-5 text-sm font-black text-neutral-900">
                      Empfehlung ansehen →
                    </span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      </section>
    ) : (
      <section class="rounded-2xl bg-neutral-50 p-8 mb-12">
        <h2 class="text-xl font-bold mb-3">
          Keine Produkte gefunden
        </h2>
        <p class="text-neutral-600">
          Derzeit sind keine Produkte von {brandName} in dieser Kategorie veröffentlicht.
        </p>
      </section>
    )}

    <section class="py-10 md:py-12 border-t border-neutral-100">
      <h2 class="text-2xl md:text-3xl font-black text-neutral-900 mb-5">
        {brandName}: Worauf vor dem Kauf achten?
      </h2>
      <p class="max-w-3xl text-neutral-600 leading-relaxed mb-6">
        Welche Eigenschaften wichtig sind, hängt vom Gerät und seinem Einsatz ab.
        Prüfen Sie vor dem Kauf die technischen Angaben auf der jeweiligen Produktseite.
      </p>
      {familyAdvice.length > 0 ? (
        <div class="grid gap-4 md:grid-cols-2">
          {familyAdvice.map((family) => (
            <article class="rounded-2xl border border-neutral-200 p-6">
              <h3 class="font-bold text-neutral-900 mb-3">{family.label}: wichtige Kaufkriterien</h3>
              <ul class="list-disc pl-5 space-y-2 text-neutral-700 leading-relaxed">
                {family.checks.map((check) => <li>{check}</li>)}
              </ul>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-2xl border border-neutral-200 p-6">
          <h3 class="font-bold text-neutral-900 mb-3">{categoryLabel}: wichtige Kaufkriterien</h3>
          <ul class="list-disc pl-5 space-y-2 text-neutral-700 leading-relaxed">
            {buyingAdvice.map((advice) => <li>{advice}</li>)}
          </ul>
        </div>
      )}
    </section>

    <section class="py-10 md:py-12 border-t border-neutral-100">
      <h2 class="text-2xl font-black text-neutral-900 mb-5">
        Welche Informationen bieten die Produktseiten?
      </h2>

      <div class="max-w-3xl space-y-4 text-neutral-600 leading-relaxed">
        <p>
          Die einzelnen Empfehlungen enthalten Informationen zu den
          beschriebenen Geräten, ihren Funktionen und möglichen
          Einschränkungen. So können Sie besser einschätzen, ob ein Produkt
          für Ihren Einsatzzweck infrage kommt.
        </p>

        <p>
          Vergleichen Sie vor einer Kaufentscheidung die Herstellerangaben,
          den Lieferumfang und die Voraussetzungen für die Nutzung.
          Nicht jede Funktion ist mit jedem vorhandenen Gerät kompatibel.
        </p>
      </div>
    </section>

    {alternativesByFamily.length > 0 && (
      <section class="py-10 md:py-12 border-t border-neutral-100">
        <h2 class="text-2xl md:text-3xl font-black text-neutral-900 mb-5">
          Alternativen anderer Hersteller
        </h2>
        <p class="max-w-3xl text-neutral-600 mb-6 leading-relaxed">
          Weitere veröffentlichte Geräte derselben Produktart können bei der Auswahl helfen.
          Ausstattung, Kapazität und Kompatibilität können sich deutlich unterscheiden.
        </p>
        <div class="space-y-8">
          {alternativesByFamily.map((group) => (
            <div>
              <h3 class="text-lg font-bold text-neutral-900 mb-3">{group.label}</h3>
              <ul class="grid gap-3 md:grid-cols-2">
                {group.products.map((entry) => (
                  <li>
                    <a href={getProductUrl(entry)} class="block rounded-xl border border-neutral-200 p-4 font-semibold text-blue-700 hover:bg-blue-50 transition-colors">
                      {entry.data.title} →
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="py-10 md:py-12 border-t border-neutral-100">
        <h2 class="text-2xl md:text-3xl font-black text-neutral-900 mb-5">
          Alternativen anderer Hersteller
        </h2>

        <p class="max-w-3xl text-neutral-600 mb-6 leading-relaxed">
          Weitere Produkte aus dem Bereich {categoryName} können bei der
          Auswahl helfen. Die folgenden Empfehlungen stammen von anderen
          Herstellern und sind nicht automatisch technisch gleichwertig.
        </p>

        <ul class="grid gap-3 md:grid-cols-2">
          {alternatives.map((entry) => (
            <li>
              <a
                href={getProductUrl(entry)}
                class="block rounded-xl border border-neutral-200 p-4 font-semibold text-blue-700 hover:bg-blue-50 transition-colors"
              >
                {entry.data.title} →
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="py-10 md:py-12 border-t border-neutral-100">
      <h2 class="text-2xl font-black text-neutral-900 mb-5">
        Häufige Fragen zu {brandName} und {categoryName}
      </h2>

      <div class="max-w-3xl space-y-6">
        <div>
          <h3 class="font-bold text-neutral-900 mb-2">
            Wo finde ich die technischen Daten?
          </h3>
          <p class="text-neutral-600 leading-relaxed">
            Öffnen Sie die jeweilige Produktseite. Dort finden Sie die
            verfügbaren Angaben zu Ausstattung, Funktionen und
            wichtigen Voraussetzungen.
          </p>
        </div>

        <div>
          <h3 class="font-bold text-neutral-900 mb-2">
            Sind alle Geräte miteinander kompatibel?
          </h3>
          <p class="text-neutral-600 leading-relaxed">
            Nicht unbedingt. Prüfen Sie die Anschlüsse, unterstützten
            Standards und Herstellerangaben für jedes Gerät einzeln.
          </p>
        </div>

        <div>
          <h3 class="font-bold text-neutral-900 mb-2">
            Gibt es weitere Produkte dieser Marke?
          </h3>
          <p class="text-neutral-600 leading-relaxed">
            Auf der Hauptseite von {brandName} finden Sie alle derzeit
            auf Bondarenko Empfehlungen veröffentlichten Produkte
            dieses Herstellers.
          </p>
        </div>
      </div>
    </section>

    <section
      class="mt-16 md:mt-24 p-8 md:p-14 rounded-[40px] bg-neutral-900 text-center relative overflow-hidden"
    >
      <div
        class="absolute inset-0 bg-blue-600/10 pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="relative z-10">
        <h2 class="text-2xl md:text-3xl font-black text-white mb-4">
          Weitere Produkte von {brandName}
        </h2>

        <p class="text-neutral-400 mb-8 max-w-xl mx-auto leading-relaxed">
          Entdecken Sie weitere Empfehlungen dieses Herstellers oder
          vergleichen Sie Produkte aus anderen Kategorien.
        </p>

        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a
            href={brandUrl}
            class="bg-white text-neutral-900 px-8 py-4 rounded-xl font-bold hover:bg-blue-600 hover:text-white transition-colors"
          >
            Alle {brandName} Empfehlungen
          </a>

          <a
            href="/empfehlungen/"
            class="bg-neutral-800 text-white px-8 py-4 rounded-xl font-bold hover:bg-neutral-700 transition-colors border border-neutral-700"
          >
            Alle Empfehlungen
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
