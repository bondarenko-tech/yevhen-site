---
export const prerender = true;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const produkte = await getCollection("produkte");

  const makeSlug = (value: string) => {
    return String(value)
      .toLowerCase()
      .trim()
      .replace(/&/g, "und")
      .replace(/\+/g, "plus")
      .replace(/ä/g, "ae")
      .replace(/ö/g, "oe")
      .replace(/ü/g, "ue")
      .replace(/ß/g, "ss")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  };

  const paths = [];
  const seen = new Set<string>();

  for (const entry of produkte) {
    const brand = entry.data?.brand;
    const category = entry.data?.kategorie;

    if (!brand || typeof brand !== "string") continue;
    if (!category || typeof category !== "string") continue;

    const brandName = brand.trim();
    const categoryName = category.trim();

    const brandSlug = makeSlug(brandName);
    const categorySlug = makeSlug(categoryName);

    if (!brandSlug || !categorySlug) continue;

    const key = `${brandSlug}|${categorySlug}`;

    if (seen.has(key)) continue;

    seen.add(key);

    paths.push({
      params: {
        brand: brandSlug,
        kategorie: categorySlug,
      },
      props: {
        brandName,
        categoryName,
      },
    });
  }

  return paths;
}

const SITE =
  Astro.site?.toString().replace(/\/$/, "") ??
  "https://yevhenbondarenko.com";

const makeSlug = (value: string) => {
  return String(value)
    .toLowerCase()
    .trim()
    .replace(/&/g, "und")
    .replace(/\+/g, "plus")
    .replace(/ä/g, "ae")
    .replace(/ö/g, "oe")
    .replace(/ü/g, "ue")
    .replace(/ß/g, "ss")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
};

const brandName = String(Astro.props.brandName ?? "").trim();
const categoryName = String(Astro.props.categoryName ?? "").trim();

const brandSlug = String(Astro.params.brand ?? "").trim();
const categorySlug = String(Astro.params.kategorie ?? "").trim();

const canonical =
  `${SITE}/marken/${brandSlug}/${categorySlug}/`;

const produkte = await getCollection("produkte");

function getEntrySlug(entry: any) {
  const id = String(entry.id || "")
    .replace(/\.mdx?$/, "")
    .trim();

  return id.split("/").pop() ?? "";
}

function getProductUrl(entry: any) {
  if (entry.data?.link && typeof entry.data.link === "string") {
    const link = entry.data.link.trim();

    if (link.startsWith("/")) {
      return link;
    }

    if (link.startsWith(SITE)) {
      return link;
    }
  }

  const category =
    typeof entry.data?.kategorie === "string"
      ? entry.data.kategorie.trim()
      : "";

  const slug = getEntrySlug(entry);

  if (!category || !slug) {
    return "/empfehlungen/";
  }

  return `/empfehlungen/${category}/${slug}/`;
}

function getTimestamp(value: unknown) {
  if (!value) return 0;

  const date = new Date(value as string | number | Date);
  const timestamp = date.getTime();

  return Number.isNaN(timestamp) ? 0 : timestamp;
}

const products = produkte
  .filter((entry) => {
    const brand = entry.data?.brand;
    const category = entry.data?.kategorie;

    if (!brand || typeof brand !== "string") return false;
    if (!category || typeof category !== "string") return false;

    return (
      makeSlug(brand) === brandSlug &&
      makeSlug(category) === categorySlug
    );
  })
  .sort((a, b) => {
    const dateA = getTimestamp(a.data?.datum);
    const dateB = getTimestamp(b.data?.datum);

    return dateB - dateA;
  });

const productCount = products.length;

/*
 * SEO:
 *
 * 0–1 Produkt:
 * Seite bleibt erreichbar,
 * wird aber nicht als dünne Landingpage indexiert.
 *
 * Ab 2 Produkten:
 * indexierbare Übersichtsseite.
 */
const shouldIndex = productCount >= 2;

const title =
  productCount === 1
    ? `${brandName} ${categoryName}: Produktübersicht`
    : `${brandName} ${categoryName}: ${productCount} Produkte im Überblick`;

const description =
  productCount === 1
    ? `Produkt von ${brandName} im Bereich ${categoryName} auf Bondarenko Empfehlungen ansehen.`
    : `${productCount} Produkte von ${brandName} im Bereich ${categoryName}. Empfehlungen und passende Technik auf Bondarenko Empfehlungen ansehen.`;

const breadcrumb = [
  {
    name: "Startseite",
    url: `${SITE}/`,
  },
  {
    name: "Marken",
    url: `${SITE}/marken/`,
  },
  {
    name: brandName,
    url: `${SITE}/marken/${brandSlug}/`,
  },
  {
    name: categoryName,
    url: canonical,
  },
];

const itemListSchema =
  shouldIndex
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: `${brandName} ${categoryName} Produkte`,
        url: canonical,
        numberOfItems: productCount,
        itemListElement: products.map((entry, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name:
            entry.data?.title ??
            `${brandName} ${categoryName}`,
          url: new URL(
            getProductUrl(entry),
            SITE
          ).toString(),
        })),
      }
    : null;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  robots={shouldIndex ? "index, follow" : "noindex, follow"}
  breadcrumb={breadcrumb}
>
  {itemListSchema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(itemListSchema)}
    />
  )}

  <main class="mx-auto max-w-6xl px-4 py-12 md:py-20">

    <header class="max-w-4xl mb-12 md:mb-16">

      <a
        href={`/marken/${brandSlug}/`}
        class="inline-flex items-center text-sm font-bold text-blue-600 hover:text-blue-700 mb-6"
      >
        ← Alle {brandName} Produkte
      </a>

      <div>
        <span
          class="inline-block px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-[10px] font-black uppercase tracking-[0.2em] mb-4"
        >
          Hersteller · Kategorie
        </span>
      </div>

      <h1
        class="text-4xl md:text-6xl font-black text-neutral-900 leading-tight mb-6 text-balance"
      >
        {brandName}
        <span class="text-blue-600 italic">
          {" "}{categoryName}
        </span>
      </h1>

      <p
        class="text-lg md:text-xl text-neutral-600 leading-relaxed font-medium"
      >
        {productCount === 0
          ? `Für ${brandName} sind im Bereich ${categoryName} derzeit keine veröffentlichten Produkte vorhanden.`
          : productCount === 1
            ? `Hier finden Sie das aktuell auf Bondarenko Empfehlungen veröffentlichte Produkt von ${brandName} im Bereich ${categoryName}.`
            : `Hier finden Sie ${productCount} aktuell veröffentlichte Produkte von ${brandName} im Bereich ${categoryName}.`}
      </p>

    </header>

    {products.length === 0 ? (

      <section
        class="rounded-[28px] border border-neutral-100 bg-neutral-50 p-8 md:p-10"
      >

        <h2
          class="text-2xl font-black text-neutral-900 mb-3"
        >
          Keine Produkte gefunden
        </h2>

        <p
          class="text-neutral-600 leading-relaxed"
        >
          Für {brandName} sind im Bereich {categoryName}
          derzeit keine veröffentlichten Produktempfehlungen vorhanden.
        </p>

        <a
          href={`/marken/${brandSlug}/`}
          class="inline-flex mt-6 bg-neutral-900 text-white px-6 py-3 rounded-xl font-bold hover:bg-blue-600 transition-colors"
        >
          Alle {brandName} Produkte
        </a>

      </section>

    ) : (

      <section class="mb-16 md:mb-20">

        <div
          class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between mb-8"
        >

          <div>

            <p
              class="text-xs font-black uppercase tracking-[0.2em] text-neutral-400 mb-2"
            >
              Produktübersicht
            </p>

            <h2
              class="text-2xl md:text-3xl font-black text-neutral-900"
            >
              {brandName} Produkte aus {categoryName}
            </h2>

          </div>

          <p
            class="text-sm font-bold text-neutral-500"
          >
            {productCount}{" "}
            {productCount === 1
              ? "Produkt"
              : "Produkte"}
          </p>

        </div>

        <div
          class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
        >

          {products.map((entry) => {
            const productUrl = getProductUrl(entry);

            const productDescription =
              typeof entry.data?.teaser === "string" &&
              entry.data.teaser.trim()
                ? entry.data.teaser.trim()
                : typeof entry.data?.description === "string"
                  ? entry.data.description.trim()
                  : "";

            return (

              <article
                class="group rounded-[32px] border border-neutral-100 bg-neutral-50/50 overflow-hidden hover:bg-white hover:shadow-2xl hover:shadow-blue-500/5 transition-all duration-500"
              >

                <a
                  href={productUrl}
                  class="block h-full"
                  aria-label={`${entry.data.title} ansehen`}
                >

                  {entry.data?.image &&
                    typeof entry.data.image === "string" && (

                      <div
                        class="aspect-video overflow-hidden bg-white"
                      >

                        <img
                          src={entry.data.image}
                          alt={String(
                            entry.data.title ??
                            `${brandName} ${categoryName}`
                          )}
                          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                          loading="lazy"
                          decoding="async"
                          width="640"
                          height="360"
                        />

                      </div>

                    )}

                  <div class="p-7 md:p-8">

                    <span
                      class="text-[10px] font-black uppercase tracking-widest text-blue-600 mb-3 block"
                    >
                      {categoryName}
                    </span>

                    <h3
                      class="text-xl font-bold mb-3 text-neutral-900 group-hover:text-blue-600 transition-colors"
                    >
                      {entry.data.title}
                    </h3>

                    {productDescription && (

                      <p
                        class="text-sm text-neutral-500 leading-relaxed font-medium line-clamp-3"
                      >
                        {productDescription}
                      </p>

                    )}

                    <span
                      class="inline-flex items-center mt-5 text-sm font-black text-neutral-900 group-hover:text-blue-600 transition-colors"
                      aria-hidden="true"
                    >
                      Empfehlung ansehen
                      <span class="ml-2">
                        →
                      </span>
                    </span>

                  </div>

                </a>

              </article>

            );
          })}

        </div>

      </section>

    )}

    {productCount >= 2 && (

      <section
        class="py-10 md:py-12 border-t border-neutral-100"
      >

        <h2
          class="text-xl md:text-2xl font-black text-neutral-900 mb-5"
        >
          {brandName} in der Kategorie {categoryName}
        </h2>

        <div
          class="max-w-3xl text-neutral-600 leading-relaxed space-y-4"
        >

          <p>
            Diese Übersicht bündelt die auf Bondarenko Empfehlungen
            veröffentlichten Produkte von {brandName} aus dem Bereich{" "}
            {categoryName}.
          </p>

          <p>
            Öffnen Sie die einzelnen Produktseiten, um Informationen
            zu Ausstattung, Einsatzbereich und wichtigen Hinweisen
            zu erhalten.
          </p>

        </div>

      </section>

    )}

    <section
      class="mt-16 md:mt-24 p-8 md:p-14 rounded-[40px] bg-neutral-900 text-center relative overflow-hidden"
    >

      <div
        class="absolute inset-0 bg-blue-600/10 pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="relative z-10">

        <h2
          class="text-2xl md:text-3xl font-black text-white mb-4"
        >
          Weitere Produkte von {brandName}
        </h2>

        <p
          class="text-neutral-400 mb-8 max-w-xl mx-auto font-medium leading-relaxed"
        >
          Auf der Markenseite finden Sie alle aktuell veröffentlichten
          Empfehlungen dieses Herstellers.
        </p>

        <div
          class="flex flex-col sm:flex-row justify-center gap-4"
        >

          <a
            href={`/marken/${brandSlug}/`}
            class="bg-white text-neutral-900 px-8 py-4 rounded-xl font-bold hover:bg-blue-600 hover:text-white transition-all"
          >
            Alle {brandName} Empfehlungen
          </a>

          <a
            href="/empfehlungen/"
            class="bg-neutral-800 text-white px-8 py-4 rounded-xl font-bold hover:bg-neutral-700 transition-all border border-neutral-700"
          >
            Alle Empfehlungen
          </a>

        </div>

      </div>

    </section>

  </main>

</BaseLayout>