---
export const prerender = true;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const produkte = await getCollection("produkte");

  const makeSlugInside = (value: string) => {
    return String(value)
      .toLowerCase()
      .trim()
      .replace(/&/g, "und")
      .replace(/\+/g, "plus")
      .replace(/ä/g, "ae")
      .replace(/ö/g, "oe")
      .replace(/ü/g, "ue")
      .replace(/ß/g, "ss")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  };

  const paths = [];
  const seen = new Set();

  for (const entry of produkte) {
    const brand = entry.data?.brand;
    const kategorie = entry.data?.kategorie;

    if (!brand || typeof brand !== "string") continue;
    if (!kategorie || typeof kategorie !== "string") continue;

    const brandName = brand.trim();
    const brandSlug = makeSlugInside(brandName);
    const kategorieSlug = kategorie.trim();

    if (!brandSlug || !kategorieSlug) continue;

    const key = `${brandSlug}|${kategorieSlug}`;

    if (seen.has(key)) continue;

    seen.add(key);

    paths.push({
      params: {
        brand: brandSlug,
        kategorie: kategorieSlug,
      },
      props: {
        brandName,
        kategorie: kategorieSlug,
      },
    });
  }

  return paths;
}

const SITE =
  Astro.site?.toString().replace(/\/$/, "") ??
  "https://yevhenbondarenko.com";

const makeSlug = (value: string) => {
  return String(value)
    .toLowerCase()
    .trim()
    .replace(/&/g, "und")
    .replace(/\+/g, "plus")
    .replace(/ä/g, "ae")
    .replace(/ö/g, "oe")
    .replace(/ü/g, "ue")
    .replace(/ß/g, "ss")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
};

const brandName = Astro.props.brandName;
const kategorie = Astro.props.kategorie;

const brandSlug = Astro.params.brand;
const kategorieSlug = Astro.params.kategorie;

const canonical = `${SITE}/marken/${brandSlug}/${kategorieSlug}/`;

const title = `${brandName} ${kategorie} Empfehlungen – Technik nach Marke`;
const description = `${brandName} Produkte in der Kategorie ${kategorie}. Finden Sie passende Empfehlungen, Einschätzungen und Technik-Ratgeber auf yevhenbondarenko.com.`;

const breadcrumb = [
  { name: "Startseite", url: `${SITE}/` },
  { name: "Marken", url: `${SITE}/marken/` },
  { name: brandName, url: `${SITE}/marken/${brandSlug}/` },
  { name: kategorie, url: canonical },
];

const produkte = await getCollection("produkte");

function getEntrySlug(entry: any) {
  return String(entry.id || "")
    .replace(/\.mdx?$/, "")
    .trim();
}

function getProductUrl(entry: any) {
  if (entry.data?.link && typeof entry.data.link === "string") {
    return entry.data.link;
  }

  if (!entry.data?.kategorie) {
    return "/empfehlungen/";
  }

  return `/empfehlungen/${entry.data.kategorie}/${getEntrySlug(entry)}/`;
}

const products = produkte
  .filter((entry) => {
    const brand = entry.data?.brand;
    const entryKategorie = entry.data?.kategorie;

    if (!brand || typeof brand !== "string") return false;
    if (!entryKategorie || typeof entryKategorie !== "string") return false;

    return (
      makeSlug(brand) === brandSlug &&
      entryKategorie === kategorieSlug
    );
  })
  .sort((a, b) => {
    const dateA = new Date(a.data?.datum ?? 0).getTime();
    const dateB = new Date(b.data?.datum ?? 0).getTime();

    return dateB - dateA;
  });
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  breadcrumb={breadcrumb}
>

<main class="mx-auto max-w-6xl px-4 py-12 md:py-20">

  <header class="max-w-3xl mb-16">
    <span class="inline-block px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-[10px] font-black uppercase tracking-[0.2em] mb-4">
      Marken-Kategorie
    </span>

    <h1 class="text-4xl md:text-6xl font-black text-neutral-900 leading-tight mb-6 text-balance">
      {brandName} <span class="text-blue-600 italic">{kategorie}</span>
    </h1>

    <p class="text-lg md:text-xl text-neutral-600 leading-relaxed font-medium">
      Hier finden Sie Produkte von {brandName} aus der Kategorie {kategorie}.
      Die Übersicht hilft dabei, passende Empfehlungen schneller zu finden.
    </p>
  </header>

  <section class="mb-16 grid gap-6 md:grid-cols-3">
    <article class="rounded-[28px] border border-neutral-100 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-black text-neutral-900 mb-3">
        Produkte nach Marke und Kategorie
      </h2>
      <p class="text-sm leading-relaxed text-neutral-600 font-medium">
        Diese Seite zeigt Empfehlungen von {brandName} aus dem Bereich {kategorie}.
        So lassen sich passende Produkte schneller finden.
      </p>
    </article>

    <article class="rounded-[28px] border border-neutral-100 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-black text-neutral-900 mb-3">
        Bessere Orientierung
      </h2>
      <p class="text-sm leading-relaxed text-neutral-600 font-medium">
        Wenn eine Marke mehrere Kategorien abdeckt, hilft diese Unterseite dabei,
        gezielt nur die relevanten Produkte aus {kategorie} zu betrachten.
      </p>
    </article>

    <article class="rounded-[28px] border border-neutral-100 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-black text-neutral-900 mb-3">
        Schnell zum passenden Gerät
      </h2>
      <p class="text-sm leading-relaxed text-neutral-600 font-medium">
        Die Übersicht verbindet Hersteller, Kategorie und konkrete Empfehlungen.
        Das erleichtert den Vergleich vor dem Kauf.
      </p>
    </article>
  </section>

  <section class="mb-20">
    <h2 class="text-xs font-black uppercase tracking-[0.2em] text-neutral-400 mb-8">
      Produkte
    </h2>

    {products.length === 0 ? (
      <p class="text-neutral-500">
        Für diese Kombination aus Marke und Kategorie wurden noch keine passenden Empfehlungen gefunden.
      </p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((entry) => (
          <a
            href={getProductUrl(entry)}
            class="group relative rounded-[32px] border border-neutral-100 bg-neutral-50/50 p-8 hover:bg-white hover:shadow-2xl hover:shadow-blue-500/5 transition-all duration-500"
          >
            {entry.data?.image && typeof entry.data.image === "string" && (
              <img
                src={entry.data.image}
                alt={entry.data.title}
                class="mb-5 aspect-video w-full rounded-2xl object-cover"
                loading="lazy"
              />
            )}

            <span class="text-[10px] font-black uppercase tracking-widest text-blue-600 mb-2 block">
              {kategorie}
            </span>

            <h2 class="text-xl font-bold mb-3 text-neutral-900 group-hover:text-blue-600 transition-colors">
              {entry.data.title}
            </h2>

            {entry.data?.description && (
              <p class="text-sm text-neutral-500 leading-relaxed font-medium line-clamp-3">
                {entry.data.description}
              </p>
            )}
          </a>
        ))}
      </div>
    )}
  </section>

    <section class="py-12 border-t border-neutral-100">
    <h2 class="text-xs font-black uppercase tracking-[0.2em] text-neutral-400 mb-8">
      Warum diese Kategorie-Seite hilfreich ist
    </h2>

    <div class="prose prose-neutral max-w-none">
      <p>
        Viele Nutzer suchen nicht nur nach einem Hersteller, sondern nach einer konkreten Produktkategorie.
        Diese Seite zeigt deshalb nur Empfehlungen von {brandName} aus dem Bereich {kategorie}.
      </p>

      <p>
        Das ist besonders hilfreich, wenn bereits klar ist, welche Marke interessant ist,
        aber noch mehrere Produkte oder Einsatzbereiche verglichen werden sollen.
      </p>

      <p>
        Die Übersicht ersetzt keinen Labortest und keine individuelle Beratung.
        Sie hilft aber dabei, Produktseiten, Empfehlungen und passende Kategorien schneller zu finden.
      </p>
    </div>
  </section>

  <section class="mt-24 p-8 md:p-16 rounded-[40px] bg-neutral-900 text-center relative overflow-hidden">
    <div class="absolute top-0 left-0 w-full h-full bg-blue-600/10 pointer-events-none"></div>

    <div class="relative z-10">
      <h2 class="text-2xl md:text-3xl font-black text-white mb-4">
        Weitere Produkte von {brandName}?
      </h2>

      <p class="text-neutral-400 mb-10 max-w-xl mx-auto font-medium">
        Auf der Markenseite finden Sie alle Empfehlungen dieses Herstellers.
      </p>

      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a
          href={`/marken/${brandSlug}/`}
          class="bg-white text-neutral-900 px-8 py-4 rounded-xl font-bold hover:bg-blue-600 hover:text-white transition-all"
        >
          Alle {brandName} Empfehlungen
        </a>

        <a
          href="/empfehlungen/"
          class="bg-neutral-800 text-white px-8 py-4 rounded-xl font-bold hover:bg-neutral-700 transition-all border border-neutral-700"
        >
          Alle Empfehlungen
        </a>
      </div>
    </div>
  </section>

</main>
</BaseLayout>